# /etc/report-agent/telemetry.env  (systemd EnvironmentFile, 권한 600) — 앱 서비스 이름에 맞게 경로를 바꾸세요
# >>> slide:env
# 설치: pip install "azure-monitor-opentelemetry>=1.8.10"   (Python 3.10+)
APPLICATIONINSIGHTS_CONNECTION_STRING="<Application Insights 연결 문자열>"
OTEL_SERVICE_NAME=report-agent
OTEL_RESOURCE_ATTRIBUTES=service.namespace=contoso
OTEL_TRACES_SAMPLER=always_on
# <<< slide:env
