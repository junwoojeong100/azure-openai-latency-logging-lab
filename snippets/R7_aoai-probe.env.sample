# /etc/aoai-probe.env  (권한 600, 소유자 root) — 값은 이 파일에만 두고 슬라이드·메일·코드에 적지 않습니다
# 셸이 그대로 읽는 파일이므로 공백이 있는 값은 큰따옴표로 감쌉니다
AOAI_ENDPOINT="https://<리소스 이름>.openai.azure.com"
# 앱이 쓰는 deployment 이름과 동일하게
AOAI_DEPLOYMENT="<deployment 이름>"
# 비워 두면 VM의 Managed Identity 토큰을 사용합니다 (권장, 역할: Cognitive Services OpenAI User)
AOAI_API_KEY=""
# 로컬 앱 URL (가용성 테스트가 호출하는 경로와 동일하게). VM 밖 probe 는 비워 둡니다
APP_URLS="http://127.0.0.1:11202/<경로> http://127.0.0.1:11203/<경로>"
SLOW_MS=8000
# VM 밖에 두는 probe 는 vm-outside 로 바꿉니다
PROBE_ROLE=vm-inside
